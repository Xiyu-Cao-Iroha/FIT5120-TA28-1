DATABASE_URL=postgresql+psycopg://calmpath:calmpath@localhost:5432/calmpath
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
CBD_MIN_LAT=-37.8230
CBD_MAX_LAT=-37.8050
CBD_MIN_LON=144.9400
CBD_MAX_LON=144.9700
RATE_LIMIT_PER_MINUTE=10

# Optional. Leave blank to use the demo routing provider and the local
# CBD gazetteer for place search. Set to a Google Maps Platform API key
# with the Directions API and Places API enabled to use real routing and
# address search instead - no other config or code change needed.
GOOGLE_MAPS_API_KEY=

# Optional, defaults to false. When true: (a) non-demo route comparisons
# fetch live pedestrian crowd data from the City of Melbourne open data
# portal instead of seeded data, and (b) `python -m app.seed` refreshes
# real quiet-place landmarks (libraries, galleries/museums, places of
# worship) from the same portal. No API key needed - it's all public.
# Pinned demo scenarios always use seeded pedestrian data regardless of
# this flag, so they stay reliable for a presentation. Leave false/unset
# for a fully offline-capable dev setup.
USE_LIVE_MELBOURNE_OPEN_DATA=false
