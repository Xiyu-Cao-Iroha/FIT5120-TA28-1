EXPO_PUBLIC_API_BASE_URL=http://localhost:8010/api/v1

# Client-visible - required for the real map view (Maps JavaScript API).
# This is embedded in the browser bundle, unlike the backend's key, so it
# should have Maps JavaScript API enabled and ideally an HTTP referrer
# restriction (localhost + your deployed domain) in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
